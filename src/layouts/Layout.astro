---
import "../styles/global.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import plexSansUrl from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Nicolas Pruneau",
	description = "Nicolas Pruneau, étudiant ingénieur civil en informatique — sites web et outils sur mesure pour indépendants, commerces, ASBL et jeunes entreprises. Mons et Binche, ou à distance.",
} = Astro.props;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Nicolas Pruneau",
	url: "https://nicolas-pruneau.com",
	jobTitle: "Ingénieur civil en informatique",
	sameAs: [
		"https://github.com/Nicolas-Prn",
		"https://www.linkedin.com/in/nicolas-pruneau-589a63318/",
	],
};
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#222b33" />
		<link rel="canonical" href="https://nicolas-pruneau.com/" />
		<link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={plexSansUrl} crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://nicolas-pruneau.com/" />
		<meta property="og:locale" content="fr_FR" />
		<meta name="twitter:card" content="summary" />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<slot />
		<script>
			import { initFaq } from "../scripts/interactions";
			initFaq();
		</script>
	</body>
</html>
