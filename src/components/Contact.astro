---
import { Image } from "astro:assets";
import { fr } from "../lib/typography.js";
import portrait from "../assets/portrait.jpg";

const subjects = [
	{ value: "vitrine", label: "Site vitrine" },
	{ value: "outil", label: "Outil ou automatisation" },
	{ value: "prototype", label: "Prototype" },
	{ value: "inconnu", label: "Je ne sais pas encore" },
];

const budgets = [
	{ value: "moins-750", label: "Moins de 750 €" },
	{ value: "750-1500", label: "750 à 1 500 €" },
	{ value: "plus-1500", label: "Plus de 1 500 €" },
	{ value: "inconnu", label: "Je n'en ai aucune idée" },
];
---

<section id="contact" class="sheet section" data-sheet-section="5">
	<div class="column">
		<h2 class="h2">Parlons-en</h2>
		<p class="lead">
			{
				fr(
					"Une idée vague, un projet précis, ou juste une question : le premier échange ne coûte rien et ne vous engage à rien."
				)
			}
		</p>

		<div class="direct">
			<span class="portrait-frame">
				<Image
					src={portrait}
					alt="Portrait de Nicolas Pruneau"
					width={200}
					height={250}
					densities={[1, 2]}
					format="webp"
					quality={88}
					class="portrait"
				/>
			</span>

			<form class="form" method="post" action="/api/contact" data-contact-form novalidate>
				<div class="row">
					<div class="field">
						<label for="name">Nom</label>
						<input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
					</div>
					<div class="field">
						<label for="email">E-mail</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							required
							maxlength="200"
						/>
					</div>
				</div>

				<div class="row">
					<div class="field">
						<label for="subject">{fr("De quoi s'agit-il ?")}</label>
						<select id="subject" name="subject">
							<option value="" selected>Non précisé</option>
							{subjects.map((s) => <option value={s.value}>{s.label}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="budget">Budget envisagé</label>
						<select id="budget" name="budget">
							<option value="" selected>Non précisé</option>
							{budgets.map((b) => <option value={b.value}>{fr(b.label)}</option>)}
						</select>
					</div>
				</div>

				<div class="field">
					<label for="message">Décrivez votre situation en quelques lignes</label>
					<textarea id="message" name="message" rows="5" required maxlength="5000"></textarea>
				</div>

				{/* Seen by no one, filled by bots only. */}
				<div class="decoy" aria-hidden="true">
					<label for="company">Société</label>
					<input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div class="actions">
					<button type="submit" class="submit" data-origin-fill>
						<span class="submit-label">Envoyer</span>
					</button>
					<p class="status" data-form-status role="status" aria-live="polite"></p>
				</div>
			</form>
		</div>

		<p class="phone-note micro">
			{
				fr(
					"Pas de téléphone affiché, volontairement : je réponds mieux par écrit. Nous pourrons convenir d'un appel dès le premier échange."
				)
			}
		</p>
	</div>
</section>

<style>
	.direct {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
		border-top: 1px solid var(--rule);
	}

	@media (min-width: 44em) {
		.direct {
			grid-template-columns: auto minmax(0, 1fr);
			align-items: start;
		}
	}

	/*
	 * Documented, not decorated. The photograph was shot under cold light, so it
	 * is warmed just enough to sit in the same room as the rest of the page.
	 */
	.portrait-frame {
		position: relative;
		display: block;
		width: clamp(7rem, 22vw, 10rem);
		border-radius: var(--fillet);
		overflow: hidden;
		isolation: isolate;
	}

	.portrait-frame::after {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--signal);
		mix-blend-mode: soft-light;
		opacity: 0.12;
		pointer-events: none;
	}

	.portrait {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		filter: sepia(0.07) saturate(1.05);
	}

	/* ── The form ── */

	.form {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
	}

	.row {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 34em) {
		.row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.field {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
	}

	.field label {
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		color: var(--accent);
	}

	.field input,
	.field select,
	.field textarea {
		width: 100%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--rule);
		border-radius: var(--fillet);
		background: color-mix(in oklab, var(--paper) 72%, transparent);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.5;
		transition:
			border-color 220ms var(--ease),
			background 220ms var(--ease);
	}

	.field textarea {
		resize: vertical;
		min-height: 7rem;
	}

	.field input:hover,
	.field select:hover,
	.field textarea:hover {
		border-color: color-mix(in oklab, var(--accent) 45%, var(--rule));
	}

	.field input:focus-visible,
	.field select:focus-visible,
	.field textarea:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
		border-color: transparent;
		background: var(--paper);
	}

	/* The browser's own message is the only one that knows what is wrong, so the
	   field simply marks itself and lets that message stand. */
	.field [data-invalid] {
		border-color: var(--accent);
	}

	.decoy {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem 1.25rem;
		margin-top: 0.25rem;
	}

	.submit {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 0.85rem 1.6rem;
		border: 1px solid var(--accent);
		border-radius: var(--fillet);
		background: var(--signal);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 0.9375rem;
		cursor: pointer;
		transition: color 280ms var(--ease);
	}

	.submit::before {
		content: "";
		position: absolute;
		z-index: -1;
		top: var(--oy, 50%);
		left: var(--ox, 50%);
		width: calc(var(--or, 140px) * 2);
		height: calc(var(--or, 140px) * 2);
		margin: calc(var(--or, 140px) * -1);
		border-radius: 50%;
		background: var(--stone-deep);
		transform: scale(0);
		transition: transform 460ms var(--ease-plot);
	}

	.submit:hover,
	.submit:focus-visible {
		color: var(--chalk);
	}

	.submit:hover::before,
	.submit:focus-visible::before {
		transform: scale(1);
	}

	.submit[disabled] {
		cursor: progress;
		opacity: 0.65;
	}

	.submit-label {
		position: relative;
	}

	.status {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.status[data-tone="error"] {
		color: var(--accent);
	}

	/* ── Sent ── */

	.form[data-sent] {
		display: none;
	}

	.phone-note {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		max-width: 58ch;
	}
</style>
