---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { fr } from "../lib/typography.js";
import portrait from "../assets/portrait.jpg";
---

<section id="contact" class="sheet section">
	<SectionHead index="v" note="Réponse sous 24 à 48 heures, écrite par moi." />
	<div class="column">
		<h2 class="h2">Parlons-en</h2>
		<p class="lead">
			{
				fr(
					"Une idée vague, un projet précis, ou juste une question : le premier échange ne coûte rien et ne vous engage à rien."
				)
			}
		</p>

		<div class="direct">
			<Image
				src={portrait}
				alt="Portrait de Nicolas Pruneau"
				width={200}
				height={250}
				densities={[1, 2]}
				format="webp"
				quality={88}
				class="portrait"
			/>
			<div class="direct-body">
				<p class="notice-text">
					{
						fr(
							"Le formulaire de contact n'est pas encore branché. En attendant, écrivez-moi directement — je réponds sous 24 à 48 heures :"
						)
					}
				</p>
				<p class="notice-email">
					<a href="mailto:contact@nicolas-pruneau.com">contact@nicolas-pruneau.com</a>
				</p>
			</div>
		</div>

		<p class="phone-note micro">
			{
				fr(
					"Pas de téléphone affiché, volontairement : je réponds mieux par écrit. Nous pourrons convenir d'un appel dès le premier échange."
				)
			}
		</p>
	</div>
</section>

<style>
	.direct {
		display: grid;
		gap: clamp(1.25rem, 3vw, 2rem);
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
		border-top: 1px solid var(--rule);
	}

	@media (min-width: 34em) {
		.direct {
			grid-template-columns: auto minmax(0, 1fr);
			align-items: start;
		}
	}

	/* Documented, not decorated: a rectangle, the way a photograph is printed. */
	.portrait {
		width: clamp(7rem, 22vw, 10rem);
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 2px;
		filter: saturate(0.88);
	}

	.direct-body {
		min-width: 0;
	}

	.notice-text {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 52ch;
	}

	.notice-email {
		margin: 0.9rem 0 0;
		font-family: var(--mono);
		font-size: clamp(0.875rem, 2.6vw, 1.0625rem);
		overflow-wrap: anywhere;
	}

	.notice-email a {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.notice-email a:hover {
		color: var(--ink);
	}

	.phone-note {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		max-width: 58ch;
	}
</style>
