---
import SectionMeta from "./SectionMeta.astro";
---

<section id="contact" class="contact">
	<SectionMeta numeral="v" label="Contact" note="Réponse sous 24 à 48 heures, écrite par moi." />
	<div class="content">
		<h2>Parlons-en</h2>
		<p class="lead">
			Une idée vague, un projet précis, ou juste une question : le premier échange ne coûte rien
			et ne vous engage à rien.
		</p>

		<div class="notice" data-reveal>
			<p class="notice-text">
				Le formulaire de contact n'est pas encore branché. En attendant, écrivez-moi directement
				— je réponds sous 24 à 48 heures :
			</p>
			<p class="notice-email">contact@nicolas-pruneau.com</p>
		</div>

		<p class="phone-note">
			Pas de téléphone affiché, volontairement : je réponds mieux par écrit. Nous pourrons
			convenir d'un appel dès le premier échange.
		</p>
	</div>
</section>

<style>
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 56px;
		padding: var(--section-pad) 0 clamp(48px, 8vw, 88px);
		border-top: 1px solid var(--paper-alt);
	}

	.content {
		flex: 999 1 460px;
		max-width: 700px;
	}

	h2 {
		margin: 0;
		font-size: clamp(30px, 3.6vw, 40px);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	.lead {
		margin: 16px 0 0;
		font-size: 18.5px;
		line-height: 1.65;
		max-width: 60ch;
	}

	.notice {
		margin-top: 36px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 600px;
		background: var(--paper-alt);
		border-radius: 28px;
		padding: clamp(24px, 4vw, 38px);
	}

	.notice-text {
		margin: 0;
		font-size: 18px;
		line-height: 1.65;
	}

	.notice-email {
		margin: 0;
		font-size: 22px;
		font-weight: 600;
		color: var(--accent);
	}

	.phone-note {
		font-family: var(--font-sans);
		font-size: 12.5px;
		line-height: 1.65;
		margin: 28px 0 0;
		opacity: 0.62;
		max-width: 58ch;
	}
</style>
