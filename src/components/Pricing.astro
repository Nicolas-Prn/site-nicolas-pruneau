---
import { fr } from "../lib/typography.js";

const tiers = [
	{ label: "Site vitrine une page", price: "à partir de 500 €" },
	{ label: "Site vitrine plusieurs pages", price: "à partir de 950 €" },
	{ label: "Outil sur mesure, automatisation, prototype", price: "sur devis, après un premier échange" },
];

/* Tabular by nature, so the share is set apart in the technical face. */
const schedule = [
	{ share: "30 %", detail: "à la commande, une fois la proposition acceptée" },
	{ share: "30 %", detail: "à la validation de la maquette, avant le développement" },
	{ share: "40 %", detail: "à la livraison, une fois le site en ligne" },
];

const terms = [
	{
		label: "Compris dans tous les cas",
		text: "Conception, développement, mise en ligne, optimisation mobile et vitesse, référencement technique de base, deux tours de corrections.",
	},
	{
		label: "En supplément",
		text: "Hébergement et suivi si vous souhaitez me le confier, à partir de 15 € par mois. Le nom de domaine reste à votre charge, environ 15 € par an, et à votre nom.",
	},
];
---

<section class="sheet section" data-sheet-section="3">
	<div class="column">
		<h2 class="h2">Tarifs</h2>
		<p class="lead">
			Trois repères. Le prix exact dépend du périmètre, et il est fixé par écrit avant de commencer.
		</p>

		<dl class="tiers">
			{
				tiers.map((tier) => (
					<div class="tier">
						<dt class="tier-label">{tier.label}</dt>
						<dd class="tier-price">{fr(tier.price)}</dd>
					</div>
				))
			}
		</dl>
		<p class="launch-note micro">Tarifs de lancement, le temps de constituer mon portfolio.</p>

		<div class="terms">
			{
				terms.map((term) => (
					<div class="term">
						<h3 class="term-label">{term.label}</h3>
						<p class="term-text">{fr(term.text)}</p>
					</div>
				))
			}
		</div>

		<div class="payment">
			<h3 class="h3">Vous payez au fur et à mesure</h3>
			<p class="body-text">
				{
					fr(
						"Le prix est fixé à la mission, jamais à l'heure. Il se règle en trois fois, à chaque étape franchie :"
					)
				}
			</p>
			<dl class="schedule">
				{
					schedule.map((row) => (
						<div class="schedule-row">
							<dt class="schedule-share">{fr(row.share)}</dt>
							<dd class="schedule-detail">{row.detail}</dd>
						</div>
					))
				}
			</dl>
			<p class="body-text">
				Vous ne payez donc jamais d'avance pour du travail que vous n'avez pas encore vu. À chaque
				étape, vous savez exactement où en est le projet avant d'engager la suite.
			</p>
		</div>

		<p class="legal-note micro">
			{
				fr(
					"Petite entreprise soumise au régime de la franchise de la taxe. TVA non applicable : le prix annoncé est le prix payé."
				)
			}
		</p>
	</div>
</section>

<style>
	/* ── Price schedule ── */

	.tiers {
		margin: clamp(2rem, 4vw, 3rem) 0 0;
	}

	.tier {
		display: grid;
		gap: 0.3rem;
		padding-block: 1.15rem;
		border-top: 1px solid var(--rule);
	}

	.tier-label {
		font-family: var(--display);
		font-size: 1.125rem;
		line-height: 1.35;
	}

	.tier-price {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--accent);
	}

	@media (min-width: 46em) {
		.tier {
			grid-template-columns: minmax(0, auto) minmax(0, 1fr);
			column-gap: 1.5rem;
			align-items: baseline;
		}

		/* The leader is the dd's own first box, so the markup stays a plain list. */
		.tier-price {
			display: flex;
			align-items: baseline;
			justify-content: flex-end;
			gap: 1rem;
			text-align: right;
		}

		.tier-price::before {
			content: "";
			flex: 1 1 2rem;
			min-width: 1.5rem;
			border-bottom: 1px dotted var(--rule);
			transform: translateY(-0.3em);
		}
	}

	.launch-note {
		margin: 0.9rem 0 0;
	}

	/* ── Terms ── */

	.terms {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}

	@media (min-width: 46em) {
		.terms {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.term-label {
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--accent);
	}

	.term-text {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	/* ── Payment schedule ── */

	.payment {
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
		padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
		border-top: 1px solid var(--rule);
	}

	.schedule {
		margin: clamp(1.5rem, 3vw, 2rem) 0;
	}

	.schedule-row {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		column-gap: 1rem;
		align-items: baseline;
		padding-block: 0.85rem;
		border-top: 1px solid var(--rule);
	}

	.schedule-share {
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--accent);
	}

	.schedule-detail {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.legal-note {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		max-width: 60ch;
	}
</style>
