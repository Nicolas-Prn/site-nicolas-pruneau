---
import { Image } from "astro:assets";
import openingImage from "../assets/opening.jpg";
---

<div class="wrap">
	<figure data-reveal>
		<div class="frame">
			<Image
				src={openingImage}
				alt="Code d'un site web affiché sur un écran d'ordinateur portable"
				format="webp"
				quality={80}
				widths={[600, 1000, 1800]}
				sizes="(min-width: 1000px) 1000px, 100vw"
				class="photo"
			/>
		</div>
	</figure>
</div>

<style>
	.wrap {
		padding: 0 0 clamp(32px, 5vw, 56px);
	}

	figure {
		margin: 0;
	}

	.frame {
		border-radius: 28px;
		overflow: hidden;
		border: 1px solid var(--paper-alt);
		aspect-ratio: 16 / 7;
		min-height: 210px;
	}

	.photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: sepia(0.42) saturate(0.8) contrast(1.02) brightness(0.98);
	}
</style>
