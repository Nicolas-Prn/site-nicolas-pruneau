---

<footer class="colophon">
	<div class="colophon-inner">
		<div class="identity">
			<span class="name">Nicolas Pruneau</span>
			<a class="email" href="mailto:contact@nicolas-pruneau.com">contact@nicolas-pruneau.com</a>
			<span class="links">
				<a href="https://github.com/Nicolas-Prn" target="_blank" rel="noopener noreferrer">GitHub</a>
				<span class="sep" aria-hidden="true">·</span>
				<a
					href="https://www.linkedin.com/in/nicolas-pruneau-589a63318/"
					target="_blank"
					rel="noopener noreferrer">LinkedIn</a
				>
			</span>
			<span class="oss-note">Le code de ce site est public.</span>
		</div>
		<p class="imprint">Composé en Fraunces et IBM&nbsp;Plex. Mons, 2026.</p>
	</div>
</footer>

<style>
	/* The binding closes on the same stone it opened with. */
	.colophon {
		background: var(--stone);
		color: var(--chalk);
	}

	.colophon-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem clamp(2rem, 5vw, 4rem);
		max-width: var(--sheet);
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 4rem) var(--gutter);
	}

	.identity {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.name {
		font-family: var(--display);
		font-size: 1.125rem;
	}

	.email {
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--chalk);
		text-decoration-color: var(--stone-line);
		text-underline-offset: 4px;
		overflow-wrap: anywhere;
	}

	.links {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-top: 0.35rem;
		font-family: var(--mono);
		font-size: 0.75rem;
	}

	.links a {
		color: var(--chalk);
		text-decoration-color: var(--stone-line);
		text-underline-offset: 4px;
	}

	.email:hover,
	.links a:hover {
		text-decoration-color: currentColor;
	}

	.sep {
		color: var(--stone-soft);
	}

	.oss-note,
	.imprint {
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--stone-soft);
	}

	.oss-note {
		margin-top: 0.35rem;
	}

	.imprint {
		margin: 0;
		max-width: 22ch;
	}
</style>
