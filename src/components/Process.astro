---
import SectionMeta from "./SectionMeta.astro";

const steps = [
	{
		number: "01",
		title: "On en parle",
		text: "Un appel ou un café, trente minutes. Vous décrivez votre situation, je vous dis franchement si je suis la bonne personne. Gratuit et sans engagement, y compris si la conclusion est que vous n'avez pas besoin de moi.",
	},
	{
		number: "02",
		title: "Vous recevez une proposition écrite",
		text: "Ce qui est inclus, ce qui ne l'est pas, le prix ferme et le délai. Pas de facturation horaire, pas de surprise en fin de projet. Vous décidez ensuite, sans pression.",
	},
	{
		number: "03",
		title: "Je construis, vous suivez",
		text: "Vous validez la direction visuelle avant que le développement commence. Ensuite, des points d'étape réguliers : vous voyez le projet avancer, vous corrigez le tir en cours de route plutôt qu'à la fin.",
	},
	{
		number: "04",
		title: "Mise en ligne et transmission",
		text: "Je m'occupe du domaine, de l'hébergement et de la mise en ligne. Vous recevez tous les accès. À vous de voir ensuite si vous préférez gérer vous-même ou me laisser la main.",
	},
];
---

<section class="process">
	<SectionMeta numeral="ii" label="Comment ça se passe" note="Quatre étapes, et dans cet ordre." />
	<div class="content">
		<h2>Comment ça se passe<span class="dot">.</span></h2>
		{
			steps.map((step) => (
				<div class="step" data-reveal data-glow>
					<div class="glow-layer" data-glow-layer />
					<div class="number">{step.number}</div>
					<div class="body">
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.process {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 56px;
		padding: var(--section-pad) 0;
	}

	.content {
		flex: 999 1 460px;
		max-width: 700px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	h2 {
		margin: 0 0 24px;
		font-size: clamp(30px, 4.4vw, 48px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.dot {
		color: var(--highlight);
	}

	.step {
		display: flex;
		gap: 20px;
		align-items: baseline;
		padding: clamp(16px, 2.2vw, 22px);
		margin-left: -18px;
		border-radius: 24px;
		transition: background 520ms var(--ease);
	}

	.number {
		flex: 0 0 clamp(48px, 6vw, 68px);
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(36px, 5vw, 52px);
		line-height: 0.85;
		color: var(--highlight);
	}

	.body {
		flex: 1 1 auto;
	}

	.step h3 {
		margin: 0;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.3;
		transition: color 460ms var(--ease);
	}

	.step:hover h3 {
		color: var(--accent);
	}

	.step p {
		margin: 10px 0 0;
		font-size: 18.5px;
		line-height: 1.65;
		max-width: 60ch;
	}
</style>
