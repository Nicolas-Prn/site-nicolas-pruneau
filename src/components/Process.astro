---
import SectionHead from "./SectionHead.astro";
import { fr } from "../lib/typography.js";

/* A real sequence — the order carries information, so it is numbered and set as a list. */
const steps = [
	{
		number: "01",
		title: "On en parle",
		text: "Un appel ou un café, trente minutes. Vous décrivez votre situation, je vous dis franchement si je suis la bonne personne. Gratuit et sans engagement, y compris si la conclusion est que vous n'avez pas besoin de moi.",
	},
	{
		number: "02",
		title: "Vous recevez une proposition écrite",
		text: "Ce qui est inclus, ce qui ne l'est pas, le prix ferme et le délai. Pas de facturation horaire, pas de surprise en fin de projet. Vous décidez ensuite, sans pression.",
	},
	{
		number: "03",
		title: "Je construis, vous suivez",
		text: "Vous validez la direction visuelle avant que le développement commence. Ensuite, des points d'étape réguliers : vous voyez le projet avancer, vous corrigez le tir en cours de route plutôt qu'à la fin.",
	},
	{
		number: "04",
		title: "Mise en ligne et transmission",
		text: "Je m'occupe du domaine, de l'hébergement et de la mise en ligne. Vous recevez tous les accès. À vous de voir ensuite si vous préférez gérer vous-même ou me laisser la main.",
	},
];
---

<section class="sheet section">
	<SectionHead index="ii" note="Quatre étapes, et dans cet ordre." />
	<div class="column">
		<h2 class="h2">Comment ça se passe</h2>
		<ol class="steps">
			{
				steps.map((step) => (
					<li class="step">
						<span class="step-number">{step.number}</span>
						<div class="step-body">
							<h3 class="h3">{step.title}</h3>
							<p class="body-text">{fr(step.text)}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		list-style: none;
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		padding: 0;
	}

	.step {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		padding-block: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--rule);
	}

	.step-number {
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--accent);
		padding-top: 0.5em;
	}

	.step-body {
		min-width: 0;
	}
</style>
