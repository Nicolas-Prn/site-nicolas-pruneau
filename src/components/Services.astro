---
import SectionHead from "./SectionHead.astro";
import { fr } from "../lib/typography.js";

/* Three ways in, not three steps — so they carry no numbers. */
const services = [
	{
		title: "Un site qui vous représente",
		text: "Un site vitrine sur mesure, rapide, lisible sur téléphone, qui dit clairement ce que vous faites et permet qu'on vous contacte. Pas de gabarit acheté et repeint : votre site est construit pour votre activité.",
	},
	{
		title: "Un outil qui vous fait gagner du temps",
		text: "Vous répétez chaque semaine la même manipulation dans un tableur. Vous recopiez des données d'un système vers un autre. Vous compilez un rapport à la main. Ce sont des heures récupérables, et le programme qui les récupère se construit souvent en quelques jours.",
	},
	{
		title: "Une première version de votre projet",
		text: "Vous avez une idée mais rien de tangible à montrer. Un prototype fonctionnel permet de la tester, de la présenter, et de savoir si elle tient debout avant d'y engager un vrai budget.",
	},
];
---

<section class="sheet section">
	<SectionHead index="i" note="Trois portes d'entrée, pas trois forfaits." />
	<div class="column">
		<h2 class="h2">Ce que je fais</h2>
		<p class="lead">
			{
				fr(
					"Trois portes d'entrée. Aucune n'est limitative : si votre besoin ne rentre dans aucune case, c'est probablement qu'il mérite une discussion."
				)
			}
		</p>

		<div class="entries">
			{
				services.map((service) => (
					<article class="entry">
						<h3 class="h3">{service.title}</h3>
						<p class="body-text">{fr(service.text)}</p>
					</article>
				))
			}
		</div>

		<p class="tech-note">
			{fr("Techniquement :")}
			<span class="tech-list">Python, Django, FastAPI, Node.js, React, Docker, WordPress</span>
			{
				fr(
					" lorsque c'est le bon choix. Cette liste n'a rien de fermé : la première compétence d'un ingénieur est de s'adapter à un problème qu'il n'a pas encore rencontré."
				)
			}
		</p>
	</div>
</section>

<style>
	.entries {
		margin-top: clamp(2rem, 4vw, 3rem);
	}

	.entry {
		padding-block: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--rule);
	}

	.tech-note {
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	/* Tools are named in the technical face. */
	.tech-list {
		font-family: var(--mono);
		font-size: 0.875em;
		color: var(--ink);
	}
</style>
