---
/*
 * The cover is a drawing sheet. The apparatus is real: registration marks sit
 * at the trim corners, a dimension line measures the title column, and the
 * cartouche carries the fields an engineering title block actually carries.
 * Every value in it is true, including the scale — the page is shown at 1:1.
 */
const cartouche = [
	{ field: "Dessinateur", value: "Nicolas Pruneau" },
	{ field: "Objet", value: "Sites web et outils sur mesure" },
	{ field: "Lieu", value: "Mons · Binche, Belgique" },
	{ field: "Échelle", value: "1:1" },
];
---

<header class="cover">
	<div class="cover-inner">
		<span class="mark mark-tl" aria-hidden="true"></span>
		<span class="mark mark-tr" aria-hidden="true"></span>
		<span class="mark mark-bl" aria-hidden="true"></span>
		<span class="mark mark-br" aria-hidden="true"></span>

		<div class="plate">
			<h1 class="title">
				<span class="line">Un site, un outil interne, un prototype.</span>
				<span class="line">
					Je conçois <span class="key">ce qui n'existe pas encore</span>.
				</span>
			</h1>

			<svg class="dimension" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0.5 1V11M399.5 1V11" />
				<path d="M0.5 6H399.5" />
				<path d="M6 3L1 6L6 9M394 3L399 6L394 9" fill="none" />
			</svg>

			<p class="sub">
				Étudiant ingénieur civil à la Faculté Polytechnique de Mons, orientation informatique et
				intelligence artificielle. Je conçois des sites vitrines et des outils sur mesure pour les
				indépendants, commerces, ASBL et jeunes entreprises.
			</p>

			<a href="#contact" class="cta">
				Me contacter
				<svg class="cta-arrow" viewBox="0 0 20 12" aria-hidden="true">
					<path d="M0 6H18M13 1L18 6L13 11" />
				</svg>
			</a>
		</div>

		<dl class="cartouche">
			{
				cartouche.map((row) => (
					<div class="field">
						<dt>{row.field}</dt>
						<dd>{row.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</header>

<style>
	.cover {
		background: var(--stone);
		color: var(--chalk);
	}

	.cover-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		max-width: var(--sheet);
		margin-inline: auto;
		/* The trim marks live inside this padding, so the bottom band has to stay
		   clear of the cartouche rather than crossing it. */
		padding: clamp(2.75rem, 6vw, 4.5rem) var(--gutter) clamp(3.5rem, 6vw, 5rem);
	}

	/* ── Registration marks at the trim corners ── */

	.mark {
		position: absolute;
		width: 22px;
		height: 22px;
	}

	.mark::before,
	.mark::after {
		content: "";
		position: absolute;
		background: var(--signal);
	}

	.mark::before {
		inset-block: 0;
		left: 50%;
		width: 1px;
	}

	.mark::after {
		inset-inline: 0;
		top: 50%;
		height: 1px;
	}

	.mark-tl {
		top: 1.25rem;
		left: calc(var(--gutter) - 11px);
	}
	.mark-tr {
		top: 1.25rem;
		right: calc(var(--gutter) - 11px);
	}
	.mark-bl {
		bottom: 1.25rem;
		left: calc(var(--gutter) - 11px);
	}
	.mark-br {
		bottom: 1.25rem;
		right: calc(var(--gutter) - 11px);
	}

	/* ── The drawn block ── */

	/* The column is set in absolute units: `ch` here would resolve against the
	   body sans, not the display face the title is actually set in. */
	.plate {
		margin-block: auto;
		max-width: min(100%, 44rem);
	}

	.title {
		margin: 0;
		font-family: var(--display);
		font-size: clamp(2.05rem, 7.2vw, 5rem);
		font-weight: 400;
		line-height: 1.06;
		letter-spacing: -0.02em;
		color: var(--stone-title);
	}

	.line {
		display: block;
	}

	.key {
		color: var(--chalk);
	}

	.dimension {
		display: block;
		width: 100%;
		height: 12px;
		margin-top: clamp(1rem, 2vw, 1.5rem);
		stroke: var(--signal);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.dimension path {
		fill: none;
	}

	.sub {
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		max-width: 48ch;
		font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
		line-height: 1.65;
		color: var(--stone-soft);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		padding: 0.9rem 1.35rem;
		border-radius: 2px;
		background: var(--signal);
		color: #ffffff;
		font-family: var(--sans);
		font-size: 0.9375rem;
		text-decoration: none;
		transition: background 240ms var(--ease);
	}

	.cta:hover {
		background: #f2683f;
	}

	.cta-arrow {
		width: 20px;
		height: 12px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: transform 240ms var(--ease);
	}

	.cta:hover .cta-arrow {
		transform: translateX(4px);
	}

	/* ── Title block ── */

	.cartouche {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
		border: 1px solid var(--stone-line);
	}

	.field {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		border-top: 1px solid var(--stone-line);
	}

	.field:first-child {
		border-top: 0;
	}

	.field dt {
		padding: 0.6rem 0.9rem;
		border-right: 1px solid var(--stone-line);
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--signal);
	}

	.field dd {
		margin: 0;
		padding: 0.6rem 0.9rem;
		min-width: 0;
		font-size: 0.8125rem;
		color: var(--chalk);
	}

	@media (min-width: 56em) {
		.cartouche {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.field {
			grid-template-columns: minmax(0, 1fr);
			border-top: 0;
			border-left: 1px solid var(--stone-line);
		}

		.field:first-child {
			border-left: 0;
		}

		.field dt {
			border-right: 0;
			border-bottom: 1px solid var(--stone-line);
		}
	}

	/*
	 * One authored moment: the sheet is plotted. Rules and marks are struck
	 * first, then each line of the title is swept in from the left.
	 * The un-animated state is the final state.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.mark,
		.dimension,
		.sub,
		.cta,
		.cartouche {
			animation: settle 420ms var(--ease) backwards;
		}

		.line {
			animation: plot 560ms var(--ease-plot) backwards;
		}

		.line:first-child {
			animation-delay: 160ms;
		}
		.line:last-child {
			animation-delay: 300ms;
		}
		.dimension {
			animation-delay: 620ms;
		}
		.sub {
			animation-delay: 540ms;
		}
		.cta {
			animation-delay: 660ms;
		}
		.cartouche {
			animation-delay: 720ms;
		}
		.mark {
			animation-delay: 780ms;
		}
	}

	@keyframes plot {
		from {
			clip-path: inset(0 100% 0 0);
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
		}
	}
</style>
