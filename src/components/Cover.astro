---
/*
 * The cover is a cyanotype. The drawing is not ornament laid behind the type:
 * it is a compass-and-straightedge construction that fills the sheet the way a
 * photograph would, and the title is set into the space the construction opens
 * on the left. Everything is vector, so density costs almost nothing.
 *
 * The cartouche carries facts a prospect can use, in the form of a title block.
 */
const cartouche = [
	{ field: "Auteur", value: "Nicolas Pruneau" },
	{ field: "Fonction", value: "Ingénieur civil en informatique" },
	{ field: "Secteur", value: "Mons · Binche, ou à distance" },
	{ field: "Réponse", value: "Sous 24 à 48 heures" },
];
---

<header class="cover">
	<div class="grid" aria-hidden="true"></div>

	<svg
		class="plate"
		viewBox="0 0 1200 900"
		preserveAspectRatio="xMidYMid slice"
		aria-hidden="true"
		focusable="false"
	>
		<defs>
			<pattern id="hatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
				<line x1="0" y1="0" x2="0" y2="7" class="s-ghost"></line>
			</pattern>
			<pattern id="hatch-dense" width="4" height="4" patternTransform="rotate(-45)" patternUnits="userSpaceOnUse">
				<line x1="0" y1="0" x2="0" y2="4" class="s-faint"></line>
			</pattern>
			<clipPath id="clip-sector">
				<path d="M860 430 L860 110 A320 320 0 0 1 1140 590 Z"></path>
			</clipPath>
		</defs>

		<!-- Radiating construction from the centre of the primary circle -->
		<g class="s-ghost">
			<line x1="860" y1="430" x2="60" y2="30"></line>
			<line x1="860" y1="430" x2="60" y2="230"></line>
			<line x1="860" y1="430" x2="40" y2="430"></line>
			<line x1="860" y1="430" x2="60" y2="630"></line>
			<line x1="860" y1="430" x2="60" y2="830"></line>
			<line x1="860" y1="430" x2="1180" y2="60"></line>
			<line x1="860" y1="430" x2="1180" y2="800"></line>
			<line x1="860" y1="430" x2="860" y2="880"></line>
			<line x1="860" y1="430" x2="860" y2="20"></line>
		</g>

		<!-- Hatched sector -->
		<rect x="540" y="110" width="640" height="640" fill="url(#hatch)" clip-path="url(#clip-sector)"></rect>

		<!-- Primary circle and its family -->
		<circle cx="860" cy="430" r="320" class="s-line"></circle>
		<circle cx="860" cy="430" r="240" class="s-faint"></circle>
		<circle cx="860" cy="430" r="160" class="s-faint"></circle>
		<circle cx="860" cy="430" r="80" class="s-ghost"></circle>
		<circle cx="860" cy="430" r="4" class="f-signal"></circle>

		<!-- Inscribed square, rotated 45°, and its diagonals -->
		<rect x="633" y="203" width="454" height="454" class="s-faint"></rect>
		<path d="M860 110 L1180 430 L860 750 L540 430 Z" class="s-line"></path>
		<path d="M633 203 L1087 657M1087 203 L633 657" class="s-ghost"></path>

		<!-- Tangent construction, upper right -->
		<path d="M860 110 L1180 110 L1180 430" class="s-ghost"></path>
		<path d="M1100 110 L1100 150M1140 110 L1140 150M1180 190 L1140 190M1180 230 L1140 230" class="s-faint"></path>

		<!-- Secondary arc family, lower left -->
		<path d="M120 900 A560 560 0 0 1 680 340" class="s-faint"></path>
		<path d="M120 900 A470 470 0 0 1 590 430" class="s-ghost"></path>
		<path d="M120 900 A650 650 0 0 1 770 250" class="s-ghost"></path>

		<!-- Hatched band, kept off the foot so the cartouche never sits on it -->
		<rect x="540" y="756" width="640" height="26" fill="url(#hatch-dense)"></rect>

		<!-- Isometric solid, an axonometric of nothing in particular: the object
		     under study is the page itself -->
		<g class="s-line" transform="translate(150 560)">
			<path d="M0 60 L104 0 L208 60 L104 120 Z"></path>
			<path d="M0 60 L0 170 L104 230 L104 120M208 60 L208 170 L104 230" class="s-faint"></path>
			<path d="M104 0 L104 120" class="s-ghost"></path>
		</g>

		<!-- Extension and dimension lines measuring the primary circle.
		     Held well inside the viewBox: `slice` crops the edges. -->
		<g class="s-signal">
			<path d="M540 680 L540 720M1180 680 L1180 720"></path>
			<path d="M540 700 L1180 700"></path>
			<path d="M552 694 L540 700 L552 706M1168 694 L1180 700 L1168 706"></path>
		</g>
	</svg>

	<div class="cover-inner">
		<span class="mark mark-tl" aria-hidden="true"></span>
		<span class="mark mark-tr" aria-hidden="true"></span>
		<span class="mark mark-bl" aria-hidden="true"></span>
		<span class="mark mark-br" aria-hidden="true"></span>

		<div class="block">
			<h1 class="title">
				<span class="line">Un site, un outil interne, un prototype.</span>
				<span class="line">
					Je conçois <span class="key">ce qui n'existe pas encore</span>.
				</span>
			</h1>

			<p class="sub">
				Étudiant ingénieur civil à la Faculté Polytechnique de Mons, orientation informatique et
				intelligence artificielle. Je conçois des sites vitrines et des outils sur mesure pour les
				indépendants, commerces, ASBL et jeunes entreprises.
			</p>

			<a href="#contact" class="cta">
				Me contacter
				<svg class="cta-arrow" viewBox="0 0 20 12" aria-hidden="true" focusable="false">
					<path d="M0 6H18M13 1L18 6L13 11"></path>
				</svg>
			</a>
		</div>

		<dl class="cartouche">
			{
				cartouche.map((row) => (
					<div class="field">
						<dt>{row.field}</dt>
						<dd>{row.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</header>

<style>
	.cover {
		position: relative;
		isolation: isolate;
		background: var(--stone);
		color: var(--chalk);
		overflow: hidden;
	}

	/* Millimetre paper, drawn in gradients so it costs no markup */
	.grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		background-image:
			repeating-linear-gradient(to right, var(--line-ghost) 0 1px, transparent 1px 40px),
			repeating-linear-gradient(to bottom, var(--line-ghost) 0 1px, transparent 1px 40px),
			repeating-linear-gradient(to right, var(--line-faint) 0 1px, transparent 1px 200px),
			repeating-linear-gradient(to bottom, var(--line-faint) 0 1px, transparent 1px 200px);
	}

	.plate {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		/* On a phone the type spans the sheet, so the drawing steps back
		   everywhere rather than in one band. */
		opacity: 0.55;
	}

	/* On a wide sheet the construction keeps clear of the title column, the way
	   a real plate leaves its left margin free. This mask is for legibility,
	   not decoration. */
	@media (min-width: 56em) {
		.plate,
		.grid {
			opacity: 1;
			mask-image: linear-gradient(
				to right,
				rgba(0, 0, 0, 0.16) 0%,
				rgba(0, 0, 0, 0.3) 26%,
				#000 58%
			);
		}
	}

	.plate :global(.s-line) {
		stroke: var(--line);
		stroke-width: 1.25;
		stroke-opacity: 0.62;
	}

	.plate :global(.s-faint) {
		stroke: var(--line);
		stroke-width: 1;
		stroke-opacity: 0.34;
	}

	.plate :global(.s-ghost) {
		stroke: var(--line);
		stroke-width: 1;
		stroke-opacity: 0.16;
	}

	.plate :global(.s-signal) {
		stroke: var(--signal);
		stroke-width: 1.25;
		stroke-opacity: 0.9;
	}

	.plate :global(.f-signal) {
		fill: var(--signal);
		stroke: none;
	}

	.cover-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		max-width: var(--sheet);
		margin-inline: auto;
		padding: clamp(2.75rem, 6vw, 4.5rem) var(--gutter) clamp(3.5rem, 6vw, 5rem);
	}

	/* ── Trim marks ── */

	.mark {
		position: absolute;
		width: 22px;
		height: 22px;
	}

	.mark::before,
	.mark::after {
		content: "";
		position: absolute;
		background: var(--signal);
	}

	.mark::before {
		inset-block: 0;
		left: 50%;
		width: 1px;
	}

	.mark::after {
		inset-inline: 0;
		top: 50%;
		height: 1px;
	}

	.mark-tl {
		top: 1.25rem;
		left: calc(var(--gutter) - 11px);
	}
	.mark-tr {
		top: 1.25rem;
		right: calc(var(--gutter) - 11px);
	}
	.mark-bl {
		bottom: 1.25rem;
		left: calc(var(--gutter) - 11px);
	}
	.mark-br {
		bottom: 1.25rem;
		right: calc(var(--gutter) - 11px);
	}

	/* ── Type set into the drawing ── */

	.block {
		margin-block: auto;
		max-width: min(100%, 40rem);
	}

	.title {
		margin: 0;
		font-family: var(--display);
		font-size: clamp(2.05rem, 6.6vw, 4.5rem);
		font-weight: 400;
		line-height: 1.06;
		letter-spacing: -0.02em;
		color: var(--stone-title);
	}

	.line {
		display: block;
	}

	.key {
		color: var(--chalk);
	}

	.sub {
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		max-width: 46ch;
		font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
		line-height: 1.65;
		color: var(--stone-soft);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
		padding: 0.9rem 1.35rem;
		border-radius: 2px;
		background: var(--signal);
		color: #221000;
		font-family: var(--sans);
		font-size: 0.9375rem;
		text-decoration: none;
		transition: background 240ms var(--ease);
	}

	.cta:hover {
		background: #ff8659;
	}

	.cta-arrow {
		width: 20px;
		height: 12px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: transform 240ms var(--ease);
	}

	.cta:hover .cta-arrow {
		transform: translateX(4px);
	}

	/* ── Title block ── */

	.cartouche {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
		border: 1px solid var(--stone-line);
		background: rgba(14, 51, 82, 0.95);
	}

	.field {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		border-top: 1px solid var(--stone-line);
	}

	.field:first-child {
		border-top: 0;
	}

	.field dt {
		padding: 0.6rem 0.9rem;
		border-right: 1px solid var(--stone-line);
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--signal);
	}

	.field dd {
		margin: 0;
		padding: 0.6rem 0.9rem;
		min-width: 0;
		font-size: 0.8125rem;
		color: var(--chalk);
	}

	@media (min-width: 56em) {
		.cartouche {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.field {
			grid-template-columns: minmax(0, 1fr);
			border-top: 0;
			border-left: 1px solid var(--stone-line);
		}

		.field:first-child {
			border-left: 0;
		}

		.field dt {
			border-right: 0;
			border-bottom: 1px solid var(--stone-line);
		}
	}

	/*
	 * One authored moment: the sheet is plotted. The construction is struck
	 * first, then the title is swept in over it.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.plate,
		.grid {
			animation: expose 900ms var(--ease) backwards;
		}

		.sub,
		.cta,
		.cartouche,
		.mark {
			animation: settle 420ms var(--ease) backwards;
		}

		.line {
			animation: plot 560ms var(--ease-plot) backwards;
		}

		.line:first-child {
			animation-delay: 260ms;
		}
		.line:last-child {
			animation-delay: 400ms;
		}
		.sub {
			animation-delay: 640ms;
		}
		.cta {
			animation-delay: 720ms;
		}
		.cartouche {
			animation-delay: 780ms;
		}
		.mark {
			animation-delay: 840ms;
		}
	}

	@keyframes plot {
		from {
			clip-path: inset(0 100% 0 0);
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
		}
	}

	@keyframes expose {
		from {
			opacity: 0;
		}
	}
</style>
